/* iOS-1: shared light theme. Values are supplied by ui.theme.ThemeTokens. */
QWidget {
    background: @APP_BACKGROUND@;
    color: @PRIMARY_TEXT@;
    font-family: @FONT_FAMILY@, sans-serif;
    font-size: @BODY_SIZE@px;
}

QMainWindow, QWidget#appRoot {
    background: @APP_BACKGROUND@;
}

QFrame#sidebar {
    background: @SECONDARY_SURFACE@;
    border-right: 1px solid @BORDER@;
}

QLabel#appTitle {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: 16px;
    font-weight: 600;
    padding: 2px 8px 8px 8px;
}

QFrame#navigation {
    background: transparent;
    border: none;
}

QLabel#managementGroupTitle {
    background: transparent;
    color: @TERTIARY_TEXT@;
    font-size: @SECONDARY_SIZE@px;
    font-weight: 600;
    padding: 4px 8px 0 8px;
}

QListWidget#primaryNavigation, QListWidget#managementNavigation {
    background: transparent;
    border: none;
    outline: none;
    padding: 0;
}

QListWidget#primaryNavigation::item, QListWidget#managementNavigation::item {
    background: transparent;
    border: 1px solid transparent;
    border-radius: @CONTROL_RADIUS@px;
    color: @SECONDARY_TEXT@;
    height: 38px;
    margin: 1px 0;
    padding: 0 12px;
}

QListWidget#primaryNavigation::item:hover, QListWidget#managementNavigation::item:hover {
    background: @SURFACE@;
    color: @PRIMARY_TEXT@;
}

QListWidget#primaryNavigation::item:selected, QListWidget#managementNavigation::item:selected {
    background: @SELECTED_SURFACE@;
    border-color: @SELECTED_BORDER@;
    color: @ACCENT@;
    font-weight: 600;
}

QStackedWidget#pageStack, QWidget#contentPage {
    background: @APP_BACKGROUND@;
}

QPushButton {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @CONTROL_RADIUS@px;
    min-height: 34px;
    padding: 0 12px;
}

QPushButton:hover {
    background: @SECONDARY_SURFACE@;
    border-color: @SELECTED_BORDER@;
}

QPushButton:pressed {
    background: @SEPARATOR@;
}

QPushButton:disabled {
    background: @SECONDARY_SURFACE@;
    border-color: @BORDER@;
    color: @TERTIARY_TEXT@;
}

QPushButton#primaryButton {
    background: @ACCENT@;
    border-color: @ACCENT@;
    color: @SURFACE@;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background: @ACCENT_HOVER@;
    border-color: @ACCENT_HOVER@;
}

QPushButton#primaryButton:pressed {
    background: @ACCENT_PRESSED@;
}

QPushButton#primaryButton:disabled {
    background: @ACCENT_DISABLED@;
    border-color: @ACCENT_DISABLED@;
    color: @SURFACE@;
}

QPushButton#dangerButton {
    background: @DANGER_SURFACE@;
    border-color: @DANGER_BORDER@;
    color: @DANGER@;
}

QPushButton#dangerButton:hover {
    background: #FFE4E2;
    border-color: @DANGER@;
}

QPushButton#dangerButton:pressed {
    background: #FFD4D0;
}

QPushButton#dangerButton:disabled {
    background: #F7F2F2;
    border-color: #E5D5D3;
    color: #B08C88;
}

QLineEdit, QTextEdit, QComboBox, QDateEdit {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @CONTROL_RADIUS@px;
    padding: 5px 8px;
}

QLineEdit, QComboBox, QDateEdit {
    min-height: 22px;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QDateEdit:focus {
    border: 2px solid @ACCENT@;
}

QLineEdit:disabled, QTextEdit:disabled, QComboBox:disabled, QDateEdit:disabled {
    background: @SECONDARY_SURFACE@;
    border-color: @BORDER@;
    color: @TERTIARY_TEXT@;
}

QLineEdit::placeholder, QTextEdit::placeholder {
    color: @TERTIARY_TEXT@;
}

QCheckBox {
    background: transparent;
    min-height: 24px;
    spacing: 8px;
}

QCheckBox::indicator {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 3px;
    height: 14px;
    width: 14px;
}

QCheckBox::indicator:checked {
    background: @ACCENT@;
    border-color: @ACCENT@;
}

QTableWidget, QTreeWidget, QListWidget {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @CONTROL_RADIUS@px;
    gridline-color: transparent;
}

QTableWidget::item, QTreeWidget::item {
    border-bottom: 1px solid @SEPARATOR@;
    padding: 8px 10px;
}

QTableWidget::item:hover, QTreeWidget::item:hover {
    background: @SECONDARY_SURFACE@;
}

QTableWidget::item:selected, QTreeWidget::item:selected {
    background: @SELECTED_SURFACE@;
    color: @PRIMARY_TEXT@;
}

QHeaderView::section {
    background: @SECONDARY_SURFACE@;
    border: none;
    border-bottom: 1px solid @BORDER@;
    color: @SECONDARY_TEXT@;
    font-weight: 600;
    min-height: 34px;
    padding: 0 10px;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    margin: 4px 2px;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #C7C7CC;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #AEAEB2;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px 4px;
}

QScrollBar::handle:horizontal {
    background: #C7C7CC;
    border-radius: 4px;
    min-width: 28px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
    border: none;
}

QProgressBar {
    background: @SEPARATOR@;
    border: none;
    border-radius: 4px;
    color: transparent;
    max-height: 8px;
    min-height: 8px;
}

QProgressBar::chunk {
    background: @ACCENT@;
    border-radius: 4px;
}

/* UI-2: compact Dashboard workbench. */
QLabel#pageTitle, QLabel#templatePageTitle {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: @PAGE_TITLE_SIZE@px;
    font-weight: 600;
}

QLabel#sectionTitle, QLabel#dialogSectionTitle,
QLabel#mergedPaymentSectionTitle, QLabel#mergedPaymentResultTitle,
QLabel#mergedPaymentSourceTitle, QLabel#itemDetailStatusTitle {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: @SECTION_TITLE_SIZE@px;
    font-weight: 600;
}

QLabel#emptyStateTitle {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: 16px;
    font-weight: 600;
}

QFrame#dashboardStatCard, QFrame#dashboardPendingItem {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @CARD_RADIUS@px;
}

QLabel#dashboardPageSubtitle, QLabel#dashboardPendingSummary,
QLabel#dashboardStatHint, QLabel#dashboardProgressLabel {
    background: transparent;
    color: @SECONDARY_TEXT@;
    font-size: @SECONDARY_SIZE@px;
}

QLabel#pendingMaterialsSubtitle {
    background: transparent;
    color: @SECONDARY_TEXT@;
    font-size: @SECONDARY_SIZE@px;
}

QFrame#pendingMaterialsListSurface {
    background: @SURFACE@;
    border: 1px solid #E5E5EA;
    border-radius: @CARD_RADIUS@px;
}

QTableWidget#pendingMaterialsTable {
    background: @SURFACE@;
    border: none;
    border-radius: @CARD_RADIUS@px;
    alternate-background-color: @SURFACE@;
}

QTableWidget#pendingMaterialsTable::item {
    border-bottom: 1px solid #E5E5EA;
    padding: 10px 12px;
}

QTableWidget#pendingMaterialsTable::item:hover {
    background: @SECONDARY_SURFACE@;
}

QTableWidget#pendingMaterialsTable::item:selected {
    background: #E5F1FF;
    color: @PRIMARY_TEXT@;
}

QLabel#batchListSubtitle {
    background: transparent;
    color: @SECONDARY_TEXT@;
    font-size: @SECONDARY_SIZE@px;
}

QFrame#batchListSurface {
    background: @SURFACE@;
    border: 1px solid #E5E5EA;
    border-radius: @CARD_RADIUS@px;
}

QTableWidget#batchTable {
    background: @SURFACE@;
    border: none;
    border-radius: @CARD_RADIUS@px;
    alternate-background-color: @SURFACE@;
}

QTableWidget#batchTable::item {
    border-bottom: 1px solid #E5E5EA;
    padding: 10px 12px;
}

QTableWidget#batchTable::item:hover {
    background: #F2F2F7;
}

QTableWidget#batchTable::item:selected {
    background: #E5F1FF;
    color: @PRIMARY_TEXT@;
}

QLabel#dashboardStatValue {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: 28px;
    font-weight: 600;
}

QLabel#dashboardStatValue[semantic="accent"] {
    color: @ACCENT@;
}

QLabel#dashboardStatValue[semantic="success"] {
    color: @SUCCESS@;
}

QLabel#dashboardStatValue[semantic="warning"] {
    color: @WARNING@;
}

QLabel#dashboardStatTitle, QLabel#dashboardItemBatch,
QLabel#pendingMaterialsSummary, QLabel#batchDetailSummary,
QLabel#emptyStateDescription, QLabel#dialogHint,
QLabel#mergedPaymentSourceFilename, QLabel#itemDetailStatusText {
    background: transparent;
    color: @SECONDARY_TEXT@;
    font-size: @SECONDARY_SIZE@px;
}

QLabel#dashboardItemName {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: 14px;
    font-weight: 600;
}

QLabel#dashboardProgress {
    background: transparent;
    color: @SECONDARY_TEXT@;
}

QLabel#dashboardProgressValue {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: @SECONDARY_SIZE@px;
    font-weight: 600;
}

QProgressBar#dashboardCollectionProgress, QProgressBar#dashboardSubmissionProgress {
    background: #E5E5EA;
    border: none;
    border-radius: 4px;
    max-height: 7px;
    min-height: 7px;
}

QProgressBar#dashboardCollectionProgress::chunk {
    background: @ACCENT@;
    border-radius: 4px;
}

QProgressBar#dashboardSubmissionProgress::chunk {
    background: @SUCCESS@;
    border-radius: 4px;
}

QLabel#dashboardMissing, QLabel#mergedPaymentEmpty, QLabel#mergedPaymentSourceMissing,
QLabel#mergedPaymentSourceUnsupported {
    background: #fff5e8;
    border: 1px solid #f2d5a8;
    border-radius: @BADGE_RADIUS@px;
    color: #9A5B00;
    min-height: 20px;
    padding: 2px 6px;
}

QPushButton#dashboardItemDetailButton {
    background: transparent;
    border: none;
    color: @ACCENT@;
    font-weight: 600;
    min-height: 24px;
    padding: 0 2px;
}

QPushButton#dashboardItemDetailButton:hover {
    background: transparent;
    color: @ACCENT@;
    text-decoration: underline;
}

QPushButton#dashboardItemDetailButton:disabled {
    background: transparent;
    color: @TERTIARY_TEXT@;
}

QLabel#attachmentPdfBadge, QLabel#attachmentFileBadge {
    background: #e8eff8;
    border: 1px solid #d8e5f8;
    border-radius: @BADGE_RADIUS@px;
    color: @ACCENT@;
    font-weight: 600;
    min-height: 20px;
    padding: 2px 6px;
}

QLabel#successBadge {
    background: #E9F9EE;
    border: 1px solid #A9E6B8;
    border-radius: @BADGE_RADIUS@px;
    color: #248A3D;
    min-height: 20px;
    padding: 2px 6px;
}

QLabel#warningBadge {
    background: #FFF5E6;
    border: 1px solid #FFD49A;
    border-radius: @BADGE_RADIUS@px;
    color: #9A5B00;
    min-height: 20px;
    padding: 2px 6px;
}

QLabel#dangerBadge {
    background: #FFF0EF;
    border: 1px solid #FFB7B1;
    border-radius: @BADGE_RADIUS@px;
    color: @DANGER@;
    min-height: 20px;
    padding: 2px 6px;
}

QLabel#dashboardEmptyState, QFrame#batchListEmptyState,
QFrame#batchDetailEmptyState, QFrame#allItemsEmptyState,
QFrame#pendingMaterialsEmptyState, QFrame#templateEmptyState {
    background: @SURFACE@;
    border: 1px dashed @BORDER@;
    border-radius: @CARD_RADIUS@px;
    color: @SECONDARY_TEXT@;
    padding: 24px;
}

/* UI-10: shared form, confirmation, and template-management treatment. */
QDialog#standardDialog, QMessageBox#standardMessageDialog {
    background: @APP_BACKGROUND@;
}

QMessageBox {
    background: @APP_BACKGROUND@;
}

QMessageBox QLabel {
    background: transparent;
}

QLabel#dialogTitle {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: 18px;
    font-weight: 600;
}

QDialog#standardDialog QDialogButtonBox {
    background: transparent;
}

QDialog#standardDialog QDialogButtonBox QPushButton,
QMessageBox#standardMessageDialog QPushButton {
    min-width: 78px;
}

QDialog#standardDialog QFormLayout QLabel {
    background: transparent;
    color: @SECONDARY_TEXT@;
}

QDialog#standardDialog QLineEdit, QDialog#standardDialog QComboBox {
    min-height: 30px;
}

QDialog#standardDialog QTextEdit {
    min-height: 70px;
}

QFrame#templateMaterialList {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @CARD_RADIUS@px;
}

QFrame#templateMaterialList QCheckBox {
    background: transparent;
    min-height: 28px;
}

/* iOS-11: templates, settings, and desktop modal dialogs share light grouped surfaces. */
QLabel#templatePageSubtitle, QLabel#settingsPageSubtitle,
QLabel#settingsSectionDescription, QLabel#settingsRowDetail {
    background: transparent;
    color: @SECONDARY_TEXT@;
    font-size: @SECONDARY_SIZE@px;
}

QFrame#templateListSurface, QFrame#settingsGroupSurface {
    background: @SURFACE@;
    border: 1px solid #E5E5EA;
    border-radius: @CARD_RADIUS@px;
}

QTableWidget#templateTable {
    background: @SURFACE@;
    border: none;
    border-radius: @CARD_RADIUS@px;
}

QTableWidget#templateTable::item {
    border-bottom: 1px solid #E5E5EA;
    padding: 10px 12px;
}

QTableWidget#templateTable::item:hover {
    background: @SECONDARY_SURFACE@;
}

QTableWidget#templateTable::item:selected {
    background: #E5F1FF;
    color: @PRIMARY_TEXT@;
}

QLabel#settingsSectionTitle, QLabel#settingsRowTitle {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-weight: 600;
}

QLabel#settingsSectionTitle {
    font-size: @SECTION_TITLE_SIZE@px;
}

QLabel#settingsRowTitle {
    font-size: @BODY_SIZE@px;
}

QLabel#backupResult, QLabel#restoreResult {
    background: @SECONDARY_SURFACE@;
    border: 1px solid #E5E5EA;
    border-radius: @BADGE_RADIUS@px;
    color: @SECONDARY_TEXT@;
    padding: 8px;
}

/* UI-4: compact batch context and item work area. */
QPushButton#batchDetailBackButton {
    background: transparent;
    border: none;
    color: #235b9f;
    min-height: 24px;
    padding: 0;
}

QPushButton#batchDetailBackButton:hover {
    background: transparent;
    color: #1f4f86;
    text-decoration: underline;
}

/* iOS-5: Batch Detail uses compact grouped surfaces for overview and workflow. */
QFrame#batchDetailOverview, QFrame#batchDetailWorkflow, QFrame#batchDetailListSurface {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @CARD_RADIUS@px;
}

QLabel#batchDetailMetricTitle, QLabel#batchDetailWorkflowSummary {
    background: transparent;
    color: @SECONDARY_TEXT@;
    font-size: @SECONDARY_SIZE@px;
}

QLabel#batchDetailMetricValue {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: 20px;
    font-weight: 600;
}

QLabel#batchDetailWorkflowBadge {
    background: #E8F1FF;
    border: 1px solid #B9DAFF;
    border-radius: @BADGE_RADIUS@px;
    color: @ACCENT@;
    font-weight: 600;
    min-height: 20px;
    padding: 1px 6px;
}

QLabel#batchDetailWorkflowBadge[status="reimbursed"] {
    background: #E9F9EE;
    border-color: #A9E6B8;
    color: #248A3D;
}

QLabel#batchDetailWorkflowBadge[status="archived"] {
    background: #F2F2F7;
    border-color: @BORDER@;
    color: @SECONDARY_TEXT@;
}

QTableWidget#batchDetailTable {
    background: @SURFACE@;
    border: none;
    border-radius: @CARD_RADIUS@px;
}

QTableWidget#batchDetailTable::item {
    border-bottom: 1px solid #E5E5EA;
    padding: 0 8px;
}

QTableWidget#batchDetailTable::item:hover {
    background: @SECONDARY_SURFACE@;
}

QTableWidget#batchDetailTable::item:selected {
    background: #E5F1FF;
    color: @PRIMARY_TEXT@;
}

QFrame#batchDetailDangerArea {
    background: transparent;
    border: none;
}

/* iOS-6: All Items remains information-dense inside a grouped list surface. */
QLineEdit#allItemsSearchInput {
    background: @SECONDARY_SURFACE@;
    border: 1px solid transparent;
    border-radius: @CONTROL_RADIUS@px;
    min-height: 28px;
    padding: 5px 10px;
}

QLineEdit#allItemsSearchInput:focus {
    background: @SURFACE@;
    border: 2px solid @ACCENT@;
}

QLabel#allItemsSubtitle {
    background: transparent;
    color: @SECONDARY_TEXT@;
    font-size: @SECONDARY_SIZE@px;
}

QFrame#allItemsListSurface {
    background: @SURFACE@;
    border: 1px solid #E5E5EA;
    border-radius: @CARD_RADIUS@px;
}

QTableWidget#allItemsTable {
    background: @SURFACE@;
    border: none;
    border-radius: @CARD_RADIUS@px;
}

QTableWidget#allItemsTable::item {
    border-bottom: 1px solid #E5E5EA;
    padding: 8px 12px;
}

QTableWidget#allItemsTable::item:hover {
    background: @SECONDARY_SURFACE@;
}

QTableWidget#allItemsTable::item:selected {
    background: #E5F1FF;
    color: @PRIMARY_TEXT@;
}

QLabel#allItemsWorkflowBadge {
    background: #E8F1FF;
    border: 1px solid #B9DAFF;
    border-radius: @BADGE_RADIUS@px;
    color: @ACCENT@;
    font-size: @SECONDARY_SIZE@px;
    font-weight: 600;
    min-height: 20px;
    padding: 1px 6px;
}

QLabel#allItemsWorkflowBadge[status="reimbursed"] {
    background: #E9F9EE;
    border-color: #A9E6B8;
    color: #248A3D;
}

QLabel#allItemsWorkflowBadge[status="archived"] {
    background: @SECONDARY_SURFACE@;
    border-color: @BORDER@;
    color: @SECONDARY_TEXT@;
}

/* UI-9: pending materials keep source collection and submission readiness distinct. */
/* UI-6: Item Detail information hierarchy and material sections. */
QScrollArea#itemDetailScrollArea, QScrollArea#dashboardPendingArea {
    background: transparent;
    border: none;
}

QScrollArea#itemDetailScrollArea QWidget#qt_scrollarea_viewport,
QScrollArea#dashboardPendingArea QWidget#qt_scrollarea_viewport {
    background: @APP_BACKGROUND@;
}

QWidget#itemDetailContent {
    background: @APP_BACKGROUND@;
}

QPushButton#itemDetailBackButton {
    background: transparent;
    border: none;
    color: @ACCENT@;
    min-height: 24px;
    padding: 0;
}

QPushButton#itemDetailBackButton:hover {
    background: transparent;
    color: @ACCENT@;
    text-decoration: underline;
}

QLabel#itemDetailName {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: @PAGE_TITLE_SIZE@px;
    font-weight: 600;
}

QLabel#itemDetailAmount {
    background: transparent;
    color: @ACCENT@;
    font-size: 20px;
    font-weight: 600;
}

QFrame#itemDetailMetadata, QFrame#itemDetailWorkflowCard,
QFrame#itemDetailStatusCard {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @CARD_RADIUS@px;
}

QFrame#itemDetailMetadata QLabel {
    background: transparent;
}

QLabel#itemDetailMetadataPrimary {
    background: transparent;
    color: @SECONDARY_TEXT@;
    font-size: @BODY_SIZE@px;
}

QLabel#itemDetailMetadataSecondary {
    background: transparent;
    color: @SECONDARY_TEXT@;
    font-size: @SECONDARY_SIZE@px;
}

QLabel#itemDetailStatusValue {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: 22px;
    font-weight: 600;
}

QLabel#itemDetailWorkflowBadge {
    background: @SECONDARY_SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @BADGE_RADIUS@px;
    color: @WARNING@;
    font-size: @SECONDARY_SIZE@px;
    font-weight: 600;
    min-height: 20px;
    padding: 1px 6px;
}

QLabel#itemDetailWorkflowBadge[status="submitted"] {
    color: @ACCENT@;
}

QLabel#itemDetailWorkflowBadge[status="reimbursed"] {
    color: @SUCCESS@;
}

QLabel#itemDetailWorkflowBadge[status="archived"] {
    color: @TERTIARY_TEXT@;
}

QProgressBar#itemDetailProgress {
    background: #E5E5EA;
    border: none;
    border-radius: 3px;
    max-height: 6px;
    min-height: 6px;
}

QProgressBar#itemDetailProgress::chunk {
    background: @ACCENT@;
    border-radius: 3px;
}

QProgressBar#itemDetailProgress[semantic="success"]::chunk {
    background: @SUCCESS@;
}

QPushButton#itemDetailExportButton {
    background: @SECONDARY_SURFACE@;
    border-color: @BORDER@;
    color: @ACCENT@;
    font-weight: 600;
}

/* iOS-9: payment evidence presents the two merge inputs and final result. */
QFrame#mergedPaymentSection {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @CARD_RADIUS@px;
}

QFrame#mergeOrderSource, QFrame#mergePaymentSource, QFrame#mergedPaymentResult {
    background: @SECONDARY_SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @CARD_RADIUS@px;
}

QLabel#mergedPaymentSectionTitle, QLabel#mergedPaymentResultTitle, QLabel#mergedPaymentSourceTitle {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: 15px;
    font-weight: 600;
}

QLabel#mergedPaymentSectionDescription, QLabel#mergedPaymentSourceFilename, QLabel#mergedPaymentEmpty {
    background: transparent;
    color: @SECONDARY_TEXT@;
    font-size: @SECONDARY_SIZE@px;
}

QLabel#mergedPaymentRelation, QLabel#mergedPaymentFlow {
    background: transparent;
    color: @ACCENT@;
    font-size: 15px;
    font-weight: 600;
}

QLabel#mergedPaymentSourceMissing, QLabel#mergedPaymentSourceUnsupported {
    background: #FFF7E8;
    border: 1px solid #FFE0AD;
    border-radius: @BADGE_RADIUS@px;
    color: #B36B00;
    font-size: @SECONDARY_SIZE@px;
    font-weight: 600;
    padding: 4px 7px;
}

/* iOS-8: Material sections use grouped surfaces; attachment cards stay secondary. */
QWidget#itemDetailMaterials, QWidget#attachmentGrid {
    background: transparent;
}

QFrame#materialSection {
    background: @SURFACE@;
    border: 1px solid #E5E5EA;
    border-radius: @CARD_RADIUS@px;
}

QFrame#materialSection[dropActive="true"] {
    background: @SELECTED_SURFACE@;
    border-color: @ACCENT@;
}

QLabel#materialSectionTitle {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: 16px;
    font-weight: 600;
}

QLabel#materialRequirementBadge {
    background: #E5F1FF;
    border: 1px solid #C9E2FF;
    border-radius: @BADGE_RADIUS@px;
    color: @ACCENT@;
    font-size: 12px;
    font-weight: 600;
    padding: 2px 7px;
}

QLabel#materialRequirementBadge[kind="optional"] {
    background: @SECONDARY_SURFACE@;
    border-color: #E5E5EA;
    color: @SECONDARY_TEXT@;
}

QLabel#materialAttachmentCount, QLabel#materialOptionalState {
    background: transparent;
    color: @SECONDARY_TEXT@;
    font-size: 13px;
}

QLabel#materialDropHint {
    background: transparent;
    color: @SECONDARY_TEXT@;
    font-size: 12px;
}

QLabel#materialMissingState {
    background: #FFF7E8;
    border: 1px solid #FFE0AD;
    border-radius: @BADGE_RADIUS@px;
    color: #B36B00;
    font-weight: 600;
    padding: 4px 7px;
}

QPushButton#itemDetailAddAttachmentButton {
    background: transparent;
    border: none;
    color: @ACCENT@;
    font-weight: 600;
    min-height: 24px;
    padding: 0 2px;
}

QPushButton#itemDetailAddAttachmentButton:hover {
    color: #0066D6;
    text-decoration: underline;
}

QFrame#attachmentCard {
    background: @SECONDARY_SURFACE@;
    border: 1px solid #E5E5EA;
    border-radius: 12px;
}

QFrame#attachmentCard:hover {
    background: #EAF3FF;
    border-color: #C9E2FF;
}

QPushButton#attachmentThumbnail {
    background: @SECONDARY_SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @BADGE_RADIUS@px;
    padding: 0;
}

QPushButton#attachmentThumbnail:hover {
    border-color: @ACCENT@;
    background: #E5F1FF;
}

QLabel#attachmentFilename {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-weight: 600;
}

QWidget#attachmentActions {
    background: transparent;
}

QPushButton#attachmentTextAction, QPushButton#attachmentDangerAction {
    background: transparent;
    border: none;
    min-height: 22px;
    padding: 0;
}

QPushButton#attachmentTextAction {
    color: @ACCENT@;
}

QPushButton#attachmentTextAction:hover {
    color: #0066D6;
    text-decoration: underline;
}

QPushButton#attachmentDangerAction {
    color: @DANGER@;
}

QPushButton#attachmentDangerAction:hover {
    color: #CC2F27;
    text-decoration: underline;
}

QLabel#attachmentMissingFile {
    background: #fff3f2;
    border: 1px solid #f0d9d6;
    border-radius: @BADGE_RADIUS@px;
    color: @DANGER@;
    font-weight: 600;
    min-height: 20px;
    padding: 2px 6px;
}

QFrame#itemDetailDangerZone {
    background: #fffafa;
    border: 1px solid #f0d9d6;
    border-radius: @CARD_RADIUS@px;
    color: #7d4b47;
}

/* iOS-12: common component treatment keeps all existing pages in one system. */
QFrame#pendingMaterialsListSurface, QFrame#batchListSurface,
QFrame#templateListSurface, QFrame#allItemsListSurface,
QFrame#materialSection {
    border-color: @SEPARATOR@;
}

QTableWidget#pendingMaterialsTable::item, QTableWidget#batchTable::item,
QTableWidget#templateTable::item, QTableWidget#allItemsTable::item,
QTableWidget#batchDetailTable::item {
    border-bottom-color: @SEPARATOR@;
    padding: 10px 12px;
}

QTableWidget#pendingMaterialsTable::item:selected,
QTableWidget#batchTable::item:selected,
QTableWidget#templateTable::item:selected,
QTableWidget#allItemsTable::item:selected,
QTableWidget#batchDetailTable::item:selected {
    background: @SELECTED_SURFACE@;
}

QProgressBar#dashboardCollectionProgress, QProgressBar#dashboardSubmissionProgress,
QProgressBar#itemDetailProgress {
    background: @SEPARATOR@;
    border-radius: 4px;
    max-height: 7px;
    min-height: 7px;
}

QProgressBar#dashboardCollectionProgress::chunk,
QProgressBar#dashboardSubmissionProgress::chunk,
QProgressBar#itemDetailProgress::chunk {
    border-radius: 4px;
}

QLabel#batchDetailWorkflowBadge, QLabel#allItemsWorkflowBadge,
QLabel#itemDetailWorkflowBadge, QLabel#successBadge, QLabel#warningBadge,
QLabel#dangerBadge, QLabel#attachmentPdfBadge, QLabel#attachmentFileBadge,
QLabel#materialRequirementBadge, QLabel#dashboardMissing,
QLabel#mergedPaymentEmpty, QLabel#mergedPaymentSourceMissing,
QLabel#mergedPaymentSourceUnsupported, QLabel#materialMissingState,
QLabel#attachmentMissingFile {
    border-radius: @BADGE_RADIUS@px;
    font-size: @SECONDARY_SIZE@px;
    min-height: 20px;
    padding: 2px 6px;
}

QLabel#batchDetailWorkflowBadge, QLabel#allItemsWorkflowBadge,
QLabel#itemDetailWorkflowBadge {
    background: @WARNING_SURFACE@;
    border: 1px solid @WARNING_BORDER@;
    color: @WARNING_TEXT@;
}

QLabel#batchDetailWorkflowBadge[status="submitted"],
QLabel#allItemsWorkflowBadge[status="submitted"],
QLabel#itemDetailWorkflowBadge[status="submitted"] {
    background: @SELECTED_SURFACE@;
    border-color: @SELECTED_BORDER@;
    color: @ACCENT@;
}

QLabel#batchDetailWorkflowBadge[status="reimbursed"],
QLabel#allItemsWorkflowBadge[status="reimbursed"],
QLabel#itemDetailWorkflowBadge[status="reimbursed"] {
    background: @SUCCESS_SURFACE@;
    border-color: @SUCCESS_BORDER@;
    color: @SUCCESS_TEXT@;
}

QLabel#batchDetailWorkflowBadge[status="archived"],
QLabel#allItemsWorkflowBadge[status="archived"],
QLabel#itemDetailWorkflowBadge[status="archived"] {
    background: @SECONDARY_SURFACE@;
    border-color: @BORDER@;
    color: @SECONDARY_TEXT@;
}

QLabel#successBadge {
    background: @SUCCESS_SURFACE@;
    border-color: @SUCCESS_BORDER@;
    color: @SUCCESS_TEXT@;
}

QLabel#warningBadge, QLabel#dashboardMissing, QLabel#mergedPaymentEmpty,
QLabel#mergedPaymentSourceMissing, QLabel#mergedPaymentSourceUnsupported,
QLabel#materialMissingState {
    background: @WARNING_SURFACE@;
    border-color: @WARNING_BORDER@;
    color: @WARNING_TEXT@;
}

QLabel#dangerBadge, QLabel#attachmentMissingFile {
    background: @DANGER_SURFACE@;
    border-color: @DANGER_BORDER@;
    color: @DANGER@;
}

QFrame#attachmentCard:hover {
    background: @HOVER_SURFACE@;
    border-color: @SELECTED_BORDER@;
}

QPushButton#attachmentThumbnail:hover {
    background: @SELECTED_SURFACE@;
}
