/* Shared light theme.
 *
 * Every value comes from ui.theme.ThemeTokens.  Rules are grouped by concern and
 * each selector is declared exactly once — later overrides are what made the
 * previous revision unmaintainable, so do not re-declare a selector here.
 */

/* ---------------------------------------------------------------------------
 * 1. Base and application shell
 * ------------------------------------------------------------------------ */

QWidget {
    color: @PRIMARY_TEXT@;
    font-family: @FONT_FAMILY@, sans-serif;
    font-size: @BODY_SIZE@px;
}

QMainWindow, QWidget#appRoot {
    background: @APP_BACKGROUND@;
}

QStackedWidget#pageStack, QWidget#contentPage {
    background: @APP_BACKGROUND@;
}

/* Scroll containers keep the page colour; the content widget paints itself. */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea#itemDetailScrollArea, QScrollArea#dashboardPendingArea,
QScrollArea#settingsScrollArea {
    background: transparent;
    border: none;
}

QScrollArea#itemDetailScrollArea QWidget#qt_scrollarea_viewport,
QScrollArea#dashboardPendingArea QWidget#qt_scrollarea_viewport,
QScrollArea#settingsScrollArea QWidget#qt_scrollarea_viewport {
    background: @APP_BACKGROUND@;
}

QWidget#itemDetailContent, QWidget#settingsContent, QWidget#dashboardPendingContainer {
    background: @APP_BACKGROUND@;
}

/* ---------------------------------------------------------------------------
 * 2. Sidebar and navigation
 * ------------------------------------------------------------------------ */

QFrame#sidebar {
    background: @SECONDARY_SURFACE@;
    border-right: 1px solid @BORDER@;
}

QLabel#appTitle {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: @BODY_SIZE@px;
    font-weight: 600;
    padding: 2px 8px 8px 8px;
}

QFrame#navigation {
    background: transparent;
    border: none;
}

QLabel#managementGroupTitle {
    background: transparent;
    color: @TERTIARY_TEXT@;
    font-size: @SECONDARY_SIZE@px;
    font-weight: 600;
    padding: 4px 8px 0 8px;
}

QListWidget#primaryNavigation, QListWidget#managementNavigation {
    background: transparent;
    border: none;
    outline: none;
    padding: 0;
}

QListWidget#primaryNavigation::item, QListWidget#managementNavigation::item {
    background: transparent;
    border: 1px solid transparent;
    border-radius: @CONTROL_RADIUS@px;
    color: @SECONDARY_TEXT@;
    height: @NAV_ITEM_HEIGHT@px;
    margin: 1px 0;
    padding: 0 12px;
}

QListWidget#primaryNavigation::item:hover, QListWidget#managementNavigation::item:hover {
    background: @SURFACE@;
    color: @PRIMARY_TEXT@;
}

QListWidget#primaryNavigation::item:selected, QListWidget#managementNavigation::item:selected {
    background: @SELECTED_SURFACE@;
    border-color: @SELECTED_BORDER@;
    color: @ACCENT@;
    font-weight: 600;
}

/* ---------------------------------------------------------------------------
 * 3. Buttons
 * ------------------------------------------------------------------------ */

QPushButton {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @CONTROL_RADIUS@px;
    min-height: @CONTROL_HEIGHT@px;
    padding: 0 12px;
}

QPushButton:hover {
    background: @SECONDARY_SURFACE@;
    border-color: @SELECTED_BORDER@;
}

QPushButton:pressed {
    background: @SEPARATOR@;
}

QPushButton:focus {
    border-color: @ACCENT@;
}

QPushButton:disabled {
    background: @SECONDARY_SURFACE@;
    border-color: @SEPARATOR@;
    color: @TERTIARY_TEXT@;
}

QPushButton#primaryButton {
    background: @ACCENT@;
    border-color: @ACCENT@;
    color: @SURFACE@;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background: @ACCENT_HOVER@;
    border-color: @ACCENT_HOVER@;
}

QPushButton#primaryButton:pressed {
    background: @ACCENT_PRESSED@;
}

QPushButton#primaryButton:disabled {
    background: @ACCENT_DISABLED@;
    border-color: @ACCENT_DISABLED@;
    color: @SURFACE@;
}

/* A workflow step that is still allowed but not yet recommended. */
QPushButton#primaryButton[quiet="true"] {
    background: @SURFACE@;
    border-color: @BORDER@;
    color: @ACCENT@;
    font-weight: 600;
}

QPushButton#primaryButton[quiet="true"]:hover {
    background: @HOVER_SURFACE@;
    border-color: @SELECTED_BORDER@;
}

QPushButton#primaryButton[quiet="true"]:disabled {
    background: @SECONDARY_SURFACE@;
    border-color: @SEPARATOR@;
    color: @TERTIARY_TEXT@;
}

QPushButton#dangerButton {
    background: @DANGER_SURFACE@;
    border-color: @DANGER_BORDER@;
    color: @DANGER@;
}

QPushButton#dangerButton:hover {
    background: @DANGER_HOVER_SURFACE@;
    border-color: @DANGER@;
}

QPushButton#dangerButton:pressed {
    background: @DANGER_PRESSED_SURFACE@;
}

QPushButton#dangerButton:disabled {
    background: @DANGER_ZONE_SURFACE@;
    border-color: @DANGER_ZONE_BORDER@;
    color: @TERTIARY_TEXT@;
}

/* ---------------------------------------------------------------------------
 * 4. Inputs and small controls
 * ------------------------------------------------------------------------ */

QLineEdit, QTextEdit, QComboBox, QDateEdit {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @CONTROL_RADIUS@px;
    padding: 5px 8px;
}

QLineEdit, QComboBox, QDateEdit {
    min-height: 22px;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QDateEdit:focus {
    border-color: @ACCENT@;
}

QLineEdit:disabled, QTextEdit:disabled, QComboBox:disabled, QDateEdit:disabled {
    background: @SECONDARY_SURFACE@;
    border-color: @SEPARATOR@;
    color: @TERTIARY_TEXT@;
}

QLineEdit::placeholder, QTextEdit::placeholder {
    color: @TERTIARY_TEXT@;
}

QComboBox QAbstractItemView, QMenu {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @CONTROL_RADIUS@px;
    padding: 4px;
    outline: none;
    selection-background-color: @SELECTED_SURFACE@;
    selection-color: @PRIMARY_TEXT@;
}

QToolTip {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @BADGE_RADIUS@px;
    color: @PRIMARY_TEXT@;
    padding: 4px 8px;
}

QCheckBox {
    background: transparent;
    min-height: 24px;
    spacing: 8px;
}

QCheckBox::indicator {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @RADIUS_BAR@px;
    height: 14px;
    width: 14px;
}

QCheckBox::indicator:checked {
    background: @ACCENT@;
    border-color: @ACCENT@;
}

/* 禁用时不应看起来仍然"已开启"：置灰而不是保留强调色。 */
QCheckBox::indicator:disabled {
    background: @SECONDARY_SURFACE@;
    border-color: @SEPARATOR@;
}

QCheckBox::indicator:checked:disabled {
    background: @SEPARATOR@;
    border-color: @SEPARATOR@;
}

QLineEdit#readOnlyField {
    background: @SECONDARY_SURFACE@;
    border-color: @SEPARATOR@;
    color: @SECONDARY_TEXT@;
}

/* ---------------------------------------------------------------------------
 * 5. Tables
 * ------------------------------------------------------------------------ */

QTableWidget, QTreeWidget, QListWidget {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @CONTROL_RADIUS@px;
    gridline-color: transparent;
    alternate-background-color: @SURFACE@;
}

QTableWidget::item, QTreeWidget::item {
    border-bottom: 1px solid @SEPARATOR@;
    padding: 10px 12px;
}

QTableWidget::item:hover, QTreeWidget::item:hover {
    background: @SECONDARY_SURFACE@;
}

QTableWidget::item:selected, QTreeWidget::item:selected {
    background: @SELECTED_SURFACE@;
    color: @PRIMARY_TEXT@;
}

QHeaderView::section {
    background: @SECONDARY_SURFACE@;
    border: none;
    border-bottom: 1px solid @BORDER@;
    color: @SECONDARY_TEXT@;
    font-weight: 600;
    min-height: @TABLE_HEADER_HEIGHT@px;
    padding: 0 10px;
}

/* Table containers: the surface owns the border, the table stays borderless. */
QFrame#batchListSurface, QFrame#batchDetailListSurface, QFrame#allItemsListSurface,
QFrame#pendingMaterialsListSurface, QFrame#templateListSurface,
QFrame#settingsGroupSurface, QFrame#materialSection {
    background: @SURFACE@;
    border: 1px solid @SEPARATOR@;
    border-radius: @CARD_RADIUS@px;
}

QTableWidget#batchTable, QTableWidget#batchDetailTable, QTableWidget#allItemsTable,
QTableWidget#pendingMaterialsTable, QTableWidget#templateTable {
    background: @SURFACE@;
    border: none;
    border-radius: @CARD_RADIUS@px;
}

/* ---------------------------------------------------------------------------
 * 6. Scrollbars and progress
 * ------------------------------------------------------------------------ */

QScrollBar:vertical {
    background: transparent;
    margin: 4px 2px;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: @SCROLL_HANDLE@;
    border-radius: @RADIUS_BAR@px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: @SCROLL_HANDLE_HOVER@;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px 4px;
}

QScrollBar::handle:horizontal {
    background: @SCROLL_HANDLE@;
    border-radius: @RADIUS_BAR@px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: @SCROLL_HANDLE_HOVER@;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
    border: none;
}

QProgressBar {
    background: @SEPARATOR@;
    border: none;
    border-radius: @RADIUS_BAR@px;
    color: transparent;
    max-height: 8px;
    min-height: 8px;
}

QProgressBar::chunk {
    background: @ACCENT@;
    border-radius: @RADIUS_BAR@px;
}

QProgressBar[semantic="success"]::chunk {
    background: @SUCCESS@;
}

/* ---------------------------------------------------------------------------
 * 7. Typography helpers
 * ------------------------------------------------------------------------ */

QLabel#pageTitle, QLabel#templatePageTitle, QLabel#itemDetailName {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: @PAGE_TITLE_SIZE@px;
    font-weight: 600;
}

QLabel#sectionTitle, QLabel#dialogSectionTitle, QLabel#mergedPaymentSectionTitle,
QLabel#emptyStateTitle,
QLabel#settingsSectionTitle {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: @SECTION_TITLE_SIZE@px;
    font-weight: 600;
}

/* 材料卡标题是分区内的小标题，必须低于页面级「材料」标题一级。 */
QLabel#materialSectionTitle {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: @BODY_SIZE@px;
    font-weight: 600;
}

QLabel#dashboardPageSubtitle, QLabel#dashboardPendingSummary,
QLabel#dashboardProgressLabel,
QLabel#pendingMaterialsSubtitle, QLabel#batchListSubtitle, QLabel#allItemsSubtitle,
QLabel#templatePageSubtitle, QLabel#settingsPageSubtitle,
QLabel#settingsSectionDescription, QLabel#settingsRowDetail,
QLabel#dashboardItemBatch, QLabel#pendingMaterialsSummary,
QLabel#batchDetailSummary, QLabel#emptyStateDescription, QLabel#dialogHint,
QLabel#mergedPaymentSourceFilename, QLabel#itemDetailStatusText,
QLabel#mergedPaymentSectionDescription, QLabel#mergedPaymentEmpty,
QLabel#batchDetailMetricTitle, QLabel#batchDetailWorkflowSummary,
QLabel#materialAttachmentCount,
QLabel#itemDetailMetadataPrimary, QLabel#itemDetailMetadataSecondary,
QLabel#itemDetailStatusLabel {
    background: transparent;
    color: @SECONDARY_TEXT@;
    font-size: @SECONDARY_SIZE@px;
}

QLabel#dashboardItemName, QLabel#settingsRowTitle,
QLabel#attachmentFilename {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: @BODY_SIZE@px;
    font-weight: 600;
}

/* 支付凭证三个槽位的标题：低一级的说明文字，不与分区标题争。 */
QLabel#mergedPaymentResultTitle, QLabel#mergedPaymentSourceTitle {
    background: transparent;
    color: @SECONDARY_TEXT@;
    font-size: @SECONDARY_SIZE@px;
    font-weight: 600;
}

QLabel#dashboardProgress {
    background: transparent;
    color: @SECONDARY_TEXT@;
}

QLabel#dashboardProgressValue {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: @SECONDARY_SIZE@px;
    font-weight: 600;
}

QLabel#dashboardStatValue {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: @METRIC_SIZE@px;
    font-weight: 600;
}

/* Only the outstanding count speaks in colour; the other three are neutral. */
QLabel#dashboardStatValue[semantic="warning"] {
    color: @WARNING_TEXT@;
}

QLabel#dashboardStatValue[semantic="secondary"] {
    color: @PRIMARY_TEXT@;
}

QLabel#batchDetailMetricValue {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: @SECTION_TITLE_SIZE@px;
    font-weight: 600;
}

QLabel#itemDetailAmount {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: @PAGE_TITLE_SIZE@px;
    font-weight: 600;
}

QLabel#itemDetailStatusValue {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: @SECTION_TITLE_SIZE@px;
    font-weight: 600;
}

/* 合并关系的连接符：装饰性，不与内容争色。 */
QLabel#mergedPaymentRelation, QLabel#mergedPaymentFlow {
    background: transparent;
    color: @TERTIARY_TEXT@;
    font-size: @SECTION_TITLE_SIZE@px;
    font-weight: 600;
}

QLabel#actionHint {
    background: transparent;
    color: @WARNING_TEXT@;
    font-size: @SECONDARY_SIZE@px;
}

/* ---------------------------------------------------------------------------
 * 8. Status badges
 * ------------------------------------------------------------------------ */

QLabel#batchDetailWorkflowBadge, QLabel#allItemsWorkflowBadge,
QLabel#itemDetailWorkflowBadge, QLabel#dashboardStateChip,
QLabel#successBadge, QLabel#warningBadge, QLabel#dangerBadge,
QLabel#attachmentPdfBadge, QLabel#attachmentFileBadge,
QLabel#materialRequirementBadge, QLabel#materialMissingState,
QLabel#attachmentMissingFile,
QLabel#mergedPaymentSourceMissing, QLabel#mergedPaymentSourceUnsupported {
    border-radius: @BADGE_RADIUS@px;
    font-size: @SECONDARY_SIZE@px;
    min-height: 22px;
    padding: 2px 8px;
}

/* Workflow status — one vocabulary for every page. */
QLabel#batchDetailWorkflowBadge, QLabel#allItemsWorkflowBadge,
QLabel#itemDetailWorkflowBadge {
    background: @WARNING_SURFACE@;
    border: 1px solid @WARNING_BORDER@;
    color: @WARNING_TEXT@;
}

QLabel#batchDetailWorkflowBadge[status="ready"],
QLabel#allItemsWorkflowBadge[status="ready"],
QLabel#itemDetailWorkflowBadge[status="ready"] {
    background: @SUCCESS_SURFACE@;
    border-color: @SUCCESS_BORDER@;
    color: @SUCCESS_TEXT@;
}

QLabel#batchDetailWorkflowBadge[status="incomplete"],
QLabel#allItemsWorkflowBadge[status="incomplete"],
QLabel#itemDetailWorkflowBadge[status="incomplete"] {
    background: @WARNING_SURFACE@;
    border-color: @WARNING_BORDER@;
    color: @WARNING_TEXT@;
}

QLabel#batchDetailWorkflowBadge[status="pending_payment"],
QLabel#allItemsWorkflowBadge[status="pending_payment"],
QLabel#itemDetailWorkflowBadge[status="pending_payment"] {
    background: @SELECTED_SURFACE@;
    border-color: @SELECTED_BORDER@;
    color: @ACCENT@;
}

QLabel#batchDetailWorkflowBadge[status="submitted"],
QLabel#allItemsWorkflowBadge[status="submitted"],
QLabel#itemDetailWorkflowBadge[status="submitted"] {
    background: @SELECTED_SURFACE@;
    border-color: @SELECTED_BORDER@;
    color: @ACCENT@;
}

QLabel#batchDetailWorkflowBadge[status="reimbursed"],
QLabel#allItemsWorkflowBadge[status="reimbursed"],
QLabel#itemDetailWorkflowBadge[status="reimbursed"] {
    background: @SUCCESS_SURFACE@;
    border-color: @SUCCESS_BORDER@;
    color: @SUCCESS_TEXT@;
}

QLabel#batchDetailWorkflowBadge[status="archived"],
QLabel#allItemsWorkflowBadge[status="archived"],
QLabel#itemDetailWorkflowBadge[status="archived"] {
    background: @SECONDARY_SURFACE@;
    border-color: @BORDER@;
    color: @SECONDARY_TEXT@;
}

QLabel#dashboardStateChip[status="incomplete"] {
    background: @WARNING_SURFACE@;
    border: 1px solid @WARNING_BORDER@;
    color: @WARNING_TEXT@;
}

QLabel#dashboardStateChip[status="pending_payment"] {
    background: @SELECTED_SURFACE@;
    border: 1px solid @SELECTED_BORDER@;
    color: @ACCENT@;
}

QLabel#successBadge {
    background: @SUCCESS_SURFACE@;
    border: 1px solid @SUCCESS_BORDER@;
    color: @SUCCESS_TEXT@;
}

QLabel#warningBadge, QLabel#materialMissingState,
QLabel#mergedPaymentSourceMissing, QLabel#mergedPaymentSourceUnsupported {
    background: @WARNING_SURFACE_SOFT@;
    border: 1px solid @WARNING_BORDER_SOFT@;
    color: @WARNING_TEXT@;
}

QLabel#dangerBadge, QLabel#attachmentMissingFile {
    background: @DANGER_SURFACE@;
    border: 1px solid @DANGER_BORDER@;
    color: @DANGER@;
}

QLabel#attachmentPdfBadge, QLabel#attachmentFileBadge {
    background: @INFO_SURFACE@;
    border: 1px solid @INFO_BORDER@;
    color: @ACCENT@;
    font-weight: 600;
}

/* 必需/可选是分类标签，不是状态：一律保持中性，把彩色留给状态。 */
QLabel#materialRequirementBadge,
QLabel#materialRequirementBadge[kind="optional"] {
    background: @SECONDARY_SURFACE@;
    border: 1px solid @SEPARATOR@;
    color: @SECONDARY_TEXT@;
    font-size: @BADGE_SIZE@px;
    font-weight: 600;
    padding: 2px 7px;
}

/* 材料卡的三种状态：已上传 / 待补充 / 暂无（可选但未提供）。 */
QLabel#materialOptionalState {
    background: @SECONDARY_SURFACE@;
    border: 1px solid @SEPARATOR@;
    border-radius: @BADGE_RADIUS@px;
    color: @SECONDARY_TEXT@;
    font-size: @BADGE_SIZE@px;
    min-height: 20px;
    padding: 1px 7px;
}

QLabel#materialAttachmentCount[uploaded="true"] {
    color: @SUCCESS_TEXT@;
}

QLabel#materialMissingState,
QLabel#mergedPaymentSourceMissing, QLabel#mergedPaymentSourceUnsupported {
    font-weight: 600;
    padding: 4px 7px;
}

/* Attention line on the Dashboard: warning text, not a banner. */
QLabel#dashboardMissing {
    background: transparent;
    border: none;
    border-radius: 0;
    color: @WARNING_TEXT@;
    font-size: @SECONDARY_SIZE@px;
    min-height: 0;
    padding: 0;
}

/* Nothing missing any more — the same line turns into a quiet confirmation. */
QLabel#dashboardMissing[complete="true"] {
    color: @SUCCESS_TEXT@;
}

/* ---------------------------------------------------------------------------
 * 9. Empty states
 * ------------------------------------------------------------------------ */

QLabel#dashboardEmptyState, QFrame#batchListEmptyState,
QFrame#batchDetailEmptyState, QFrame#allItemsEmptyState,
QFrame#pendingMaterialsEmptyState, QFrame#templateEmptyState {
    background: @SURFACE@;
    border: 1px dashed @BORDER@;
    border-radius: @CARD_RADIUS@px;
    color: @SECONDARY_TEXT@;
    padding: 24px;
}

/* ---------------------------------------------------------------------------
 * 10. Dashboard
 * ------------------------------------------------------------------------ */

QFrame#dashboardStatCard, QFrame#dashboardPendingItem {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @CARD_RADIUS@px;
}

/* Statistic card: quiet label, one dominant number, one quiet footnote. */
QLabel#dashboardStatTitle {
    background: transparent;
    color: @SECONDARY_TEXT@;
    font-size: @SECONDARY_SIZE@px;
    font-weight: 600;
}

QLabel#dashboardStatHint {
    background: transparent;
    color: @TERTIARY_TEXT@;
    font-size: @BADGE_SIZE@px;
}

/* The attention list sits directly on the page, so its bars stay hairline. */
QWidget#dashboardProgressBlock {
    background: transparent;
}

QProgressBar#dashboardCollectionProgress,
QProgressBar#dashboardSubmissionProgress {
    max-height: 6px;
    min-height: 6px;
}

QPushButton#dashboardItemDetailButton {
    background: transparent;
    border: none;
    color: @ACCENT@;
    font-weight: 600;
    min-height: 24px;
    padding: 0 2px;
}

QPushButton#dashboardItemDetailButton:hover {
    background: transparent;
    color: @ACCENT_HOVER@;
}

QPushButton#dashboardItemDetailButton:disabled {
    background: transparent;
    color: @TERTIARY_TEXT@;
}

/* ---------------------------------------------------------------------------
 * 11. Batch list and batch detail
 * ------------------------------------------------------------------------ */

QPushButton#batchDetailBackButton {
    background: transparent;
    border: none;
    color: @ACCENT@;
    min-height: 24px;
    padding: 0;
}

QPushButton#batchDetailBackButton:hover {
    background: transparent;
    color: @ACCENT_HOVER@;
}

QFrame#batchDetailOverview, QFrame#batchDetailWorkflow {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @CARD_RADIUS@px;
}

QFrame#batchDetailDangerArea {
    background: @DANGER_ZONE_SURFACE@;
    border: 1px solid @DANGER_ZONE_BORDER@;
    border-radius: @CARD_RADIUS@px;
}

/* ---------------------------------------------------------------------------
 * 12. All items
 * ------------------------------------------------------------------------ */

QLineEdit#allItemsSearchInput {
    background: @SECONDARY_SURFACE@;
    border: 1px solid transparent;
    border-radius: @CONTROL_RADIUS@px;
    min-height: 28px;
    padding: 5px 10px;
}

QLineEdit#allItemsSearchInput:focus {
    background: @SURFACE@;
    border-color: @ACCENT@;
}

/* ---------------------------------------------------------------------------
 * 13. Item detail
 * ------------------------------------------------------------------------ */

QPushButton#itemDetailBackButton {
    background: transparent;
    border: none;
    color: @ACCENT@;
    min-height: 24px;
    padding: 0;
}

QPushButton#itemDetailBackButton:hover {
    background: transparent;
    color: @ACCENT_HOVER@;
}

QFrame#itemDetailStatusStrip {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @CARD_RADIUS@px;
}

/* Blocks inside the strip are columns, not nested cards. */
QFrame#itemDetailStatusBlock {
    background: transparent;
    border: none;
}

QFrame#itemDetailStatusDivider {
    background: @SEPARATOR@;
    border: none;
}

QProgressBar#itemDetailProgress {
    max-height: 6px;
    min-height: 6px;
}

QLabel#itemDetailStatusPercent {
    background: transparent;
    color: @TERTIARY_TEXT@;
    font-size: @BADGE_SIZE@px;
}

/* 状态文本：缺材料用警示色，齐全用成功色，与首页保持同一套语义。 */
QLabel#itemDetailStatusText[complete="false"] {
    color: @WARNING_TEXT@;
}

QLabel#itemDetailStatusText[complete="true"] {
    color: @SUCCESS_TEXT@;
}

QPushButton#itemDetailExportButton {
    background: @SECONDARY_SURFACE@;
    border-color: @BORDER@;
    color: @ACCENT@;
    font-weight: 600;
}

QPushButton#itemDetailExportButton:hover {
    background: @HOVER_SURFACE@;
    border-color: @SELECTED_BORDER@;
}

QPushButton#itemDetailExportButton:disabled {
    background: @SECONDARY_SURFACE@;
    border-color: @SEPARATOR@;
    color: @TERTIARY_TEXT@;
}

QFrame#itemDetailDangerZone, QFrame#settingsDangerSurface {
    background: @DANGER_ZONE_SURFACE@;
    border: 1px solid @DANGER_ZONE_BORDER@;
    border-radius: @CARD_RADIUS@px;
    color: @DANGER_TEXT@;
}

/* 两个危险区共用一个标题样式，避免深浅不一。 */
QLabel#dangerZoneTitle {
    background: transparent;
    color: @DANGER_TEXT@;
    font-size: @SECTION_TITLE_SIZE@px;
    font-weight: 600;
}

/* ---------------------------------------------------------------------------
 * 14. Merged payment certificate
 * ------------------------------------------------------------------------ */

QFrame#mergedPaymentSection {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @CARD_RADIUS@px;
}

/* 三个槽位直接落在分区白底上：不再在白色卡片里套灰色卡片。 */
QFrame#mergeOrderSource, QFrame#mergePaymentSource, QFrame#mergedPaymentResult {
    background: transparent;
    border: none;
}

QLabel#mergedPaymentPlaceholder {
    background: @SECONDARY_SURFACE@;
    border: 1px dashed @BORDER@;
    border-radius: @BADGE_RADIUS@px;
    color: @TERTIARY_TEXT@;
    font-size: @BADGE_SIZE@px;
}

/* ---------------------------------------------------------------------------
 * 15. Materials and attachments
 * ------------------------------------------------------------------------ */

QWidget#itemDetailMaterials, QWidget#attachmentGrid, QWidget#attachmentActions {
    background: transparent;
}

QFrame#materialSection[dropActive="true"] {
    background: @SELECTED_SURFACE@;
    border-color: @ACCENT@;
}

QLabel#materialDropHint {
    background: transparent;
    color: @TERTIARY_TEXT@;
    font-size: @BADGE_SIZE@px;
}

QPushButton#itemDetailAddAttachmentButton {
    background: transparent;
    border: none;
    color: @ACCENT@;
    font-weight: 600;
    min-height: 24px;
    padding: 0 2px;
}

QPushButton#itemDetailAddAttachmentButton:hover {
    color: @ACCENT_HOVER@;
}

QFrame#attachmentCard {
    background: @SECONDARY_SURFACE@;
    border: 1px solid @SEPARATOR@;
    border-radius: @RADIUS_NESTED@px;
}

/* 合并结果卡直接放在分区白底上，不再自带一层灰底。 */
QFrame#attachmentCard[variant="inline"] {
    background: transparent;
    border: none;
    border-radius: 0;
}

QFrame#attachmentCard:hover {
    background: @HOVER_SURFACE@;
    border-color: @SELECTED_BORDER@;
}

QFrame#attachmentCard[variant="inline"]:hover {
    background: transparent;
}

QLabel#attachmentFileSize {
    background: transparent;
    color: @TERTIARY_TEXT@;
    font-size: @BADGE_SIZE@px;
}

QPushButton#attachmentThumbnail {
    background: @SECONDARY_SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @BADGE_RADIUS@px;
    padding: 0;
}

QPushButton#attachmentThumbnail:hover {
    background: @SELECTED_SURFACE@;
    border-color: @ACCENT@;
}

QPushButton#attachmentTextAction, QPushButton#attachmentDangerAction,
QPushButton#attachmentMutedAction {
    background: transparent;
    border: none;
    min-height: 22px;
    padding: 0;
}

QPushButton#attachmentTextAction {
    color: @ACCENT@;
}

QPushButton#attachmentTextAction:hover {
    color: @ACCENT_HOVER@;
}

/* 「文件夹」是次要动作，常态保持安静，避免三个链接同时抢注意力。 */
QPushButton#attachmentMutedAction {
    color: @SECONDARY_TEXT@;
}

QPushButton#attachmentMutedAction:hover {
    color: @PRIMARY_TEXT@;
}

QPushButton#attachmentDangerAction {
    color: @DANGER@;
}

QPushButton#attachmentDangerAction:hover {
    color: @DANGER_TEXT@;
}

/* ---------------------------------------------------------------------------
 * 16. Template management
 * ------------------------------------------------------------------------ */

QFrame#templateMaterialList {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @CARD_RADIUS@px;
}

QFrame#templateMaterialList QCheckBox {
    background: transparent;
    min-height: 28px;
}

QScrollArea#templateMaterialScroll,
QScrollArea#templateMaterialScroll QWidget#qt_scrollarea_viewport {
    background: transparent;
    border: none;
}

QPushButton#templateAddMaterialButton {
    background: transparent;
    border: 1px dashed @SELECTED_BORDER@;
    color: @ACCENT@;
    font-weight: 600;
}

QPushButton#templateAddMaterialButton:hover {
    background: @HOVER_SURFACE@;
    border-color: @ACCENT@;
}

QPushButton#templateAddMaterialButton:pressed {
    background: @SELECTED_SURFACE@;
}

/* ---------------------------------------------------------------------------
 * 16b. Template list actions
 * ------------------------------------------------------------------------ */

QWidget#templateActions {
    background: transparent;
}

QPushButton#templateEditAction, QPushButton#templateDeleteAction {
    background: transparent;
    border: none;
    min-height: 22px;
    padding: 0;
}

QPushButton#templateEditAction {
    color: @ACCENT@;
}

QPushButton#templateEditAction:hover {
    color: @ACCENT_HOVER@;
}

/* 删除是低频动作：常态安静，悬停才提示危险。 */
QPushButton#templateDeleteAction {
    color: @SECONDARY_TEXT@;
}

QPushButton#templateDeleteAction:hover {
    color: @DANGER@;
}

/* ---------------------------------------------------------------------------
 * 17. Settings
 * ------------------------------------------------------------------------ */

QLabel#backupResult, QLabel#restoreResult {
    background: @SECONDARY_SURFACE@;
    border: 1px solid @SEPARATOR@;
    border-radius: @BADGE_RADIUS@px;
    color: @SECONDARY_TEXT@;
    padding: 8px;
}

QLabel#backupResult[result="success"], QLabel#restoreResult[result="success"] {
    background: @SUCCESS_SURFACE@;
    border-color: @SUCCESS_BORDER@;
    color: @SUCCESS_TEXT@;
}

QLabel#backupResult[result="failure"], QLabel#restoreResult[result="failure"] {
    background: @DANGER_SURFACE@;
    border-color: @DANGER_BORDER@;
    color: @DANGER_TEXT@;
}

/* ---------------------------------------------------------------------------
 * 18. Dialogs
 * ------------------------------------------------------------------------ */

QDialog#standardDialog, QMessageBox#standardMessageDialog,
QMessageBox {
    background: @APP_BACKGROUND@;
}

QMessageBox QLabel {
    background: transparent;
}

QLabel#dialogTitle {
    background: transparent;
    color: @PRIMARY_TEXT@;
    font-size: @SECTION_TITLE_SIZE@px;
    font-weight: 600;
}

QLabel#dialogFieldGroupTitle {
    background: transparent;
    color: @SECONDARY_TEXT@;
    font-size: @SECONDARY_SIZE@px;
    font-weight: 600;
    padding-top: 4px;
}

QDialog#standardDialog QDialogButtonBox {
    background: transparent;
}

QDialog#standardDialog QDialogButtonBox QPushButton,
QMessageBox#standardMessageDialog QPushButton {
    min-width: 78px;
}

QDialog#standardDialog QFormLayout QLabel {
    background: transparent;
    color: @SECONDARY_TEXT@;
}

QDialog#standardDialog QLineEdit, QDialog#standardDialog QComboBox {
    min-height: 28px;
}

QDialog#standardDialog QTextEdit {
    min-height: 56px;
}

/* ---------------------------------------------------------------------------
 * 19. Update dialog
 * ------------------------------------------------------------------------ */

QTextBrowser#updateNotes {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @CARD_RADIUS@px;
    color: @SECONDARY_TEXT@;
    padding: 8px 10px;
    selection-background-color: @SELECTED_SURFACE@;
}

QProgressBar#updateProgress {
    background: @HOVER_SURFACE@;
}
